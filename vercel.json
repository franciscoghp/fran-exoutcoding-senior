{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "src/**/*.graphql",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/graphql",
      "permanent": false
    }
  ]
}
